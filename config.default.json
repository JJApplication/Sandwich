{
  "servers": [
    {
      "name": "http-server",
      "host": "0.0.0.0",
      "port": 80,
      "use_http2": false,
      "protocol": "http",
      "enabled": true,
      "max_request_body": 33554432,
      "domains": null
    },
    {
      "name": "https-server",
      "host": "0.0.0.0",
      "port": 443,
      "use_http2": false,
      "protocol": "https",
      "enabled": false,
      "max_request_body": 33554432,
      "tls": {
        "cert_file": "/path/to/cert.pem",
        "key_file": "/path/to/key.pem",
        "auto_tls": false
      },
      "domains": null
    }
  ],
  "middleware": [
    {
      "name": "limiter",
      "enabled": true,
      "order": 1,
      "config": {
        "limit": 100,
        "reset": 60
      }
    },
    {
      "name": "breaker",
      "enabled": true,
      "order": 2,
      "config": {
        "limit": 20,
        "reset": 10
      }
    }
  ],
  "features": {
    "http3": {
      "enabled": false,
      "max_connections": 1000,
      "idle_timeout": 60,
      "keep_alive": 30
    },
    "websocket": {
      "enabled": false,
      "ping_interval": 10,
      "pong_timeout": 10,
      "max_message_size": 1048576,
      "buffer_size": 1024
    },
    "gzip": {
      "enabled": true,
      "level": 6,
      "types": [
        "text/html",
        "text/css",
        "text/javascript",
        "application/json"
      ]
    },
    "cache": {
      "enabled": true,
      "size": 1000,
      "ttl": 60,
      "strategy": "lru"
    }
  },
  "database": {
    "mongo": {
      "url": "mongodb://localhost:27017",
      "database": "sandwich",
      "timeout": 10
    },
    "influx": {
      "enabled": false,
      "url": "http://localhost:8086",
      "token": "",
      "org": "sandwich",
      "bucket": "metrics",
      "password": ""
    }
  },
  "monitor": {
    "enabled": true,
    "port": 9090,
    "path": "/metrics",
    "interval": 15,
    "prometheus": true
  },
  "security": {
    "strict_mode": false,
    "allow_ips": [],
    "deny_ips": [],
    "rate_limit": 1000
  },
  "flow_control": {
    "enabled": true,
    "global_limit": {
      "requests": 1000,
      "window": "60s",
      "unit": "s"
    },
    "rules": [
      {
        "name": "api-limit",
        "enabled": true,
        "priority": 1,
        "match_type": "host",
        "match_value": "api.example.com",
        "header_key": "",
        "limits": [
          {
            "requests": 10,
            "window": "100s",
            "unit": "s"
          },
          {
            "requests": 100,
            "window": "10min",
            "unit": "min"
          }
        ],
        "action": "block",
        "description": "API服务限流"
      },
      {
        "name": "user-agent-limit",
        "enabled": true,
        "priority": 2,
        "match_type": "header",
        "match_value": "BadBot",
        "header_key": "User-Agent",
        "limits": [
          {
            "requests": 1,
            "window": "60s",
            "unit": "s"
          }
        ],
        "action": "block",
        "description": "封禁恶意爬虫"
      }
    ],
    "recording": {
      "enabled": true,
      "record_blocked": true,
      "record_allowed": false,
      "storage_type": "file",
      "retention_period": "30d"
    }
  },
  "break": {
    "bucket": 0,
    "max_error": 0,
    "reset": 0
  },
  "front_proxy": {
    "grpc_addr": "",
    "frontend_flag": "",
    "frontend_host": "",
    "frontend_port": 0
  },
  "proxy_header": {
    "trace_id": "X-Gateway-Trace-Id",
    "frontend_host_header": "X-Proxy-Internal-Host",
    "backend_header": "X-Proxy-Internal-Local",
    "proxy_app": "X-Proxy-Backend"
  },
  "log": {
    "log_level": "",
    "log_file": "",
    "color": false
  },
  "custom_header": {
    "Proxy-Copyright": "renj.io",
    "Proxy-Server": "Sandwich"
  },
  "domain_map": "",
  "job_sync_time": 0,
  "debug": false
}