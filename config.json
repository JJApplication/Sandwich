{
  "servers": [
    {
      "name": "http-server",
      "host": "0.0.0.0",
      "port": 80,
      "use_http2": true,
      "protocol": "http",
      "enabled": true,
      "domains": [
        {
          "domains": ["renj.io", "service.renj.io", "dev.renj.io", "blog.renj.io",
            "me.renj.io", "gallery.renj.io", "jjapp.renj.io", "pkg.renj.io", "app.renj.io"],
          "auto_redirect": true
        }
      ]
    },
    {
      "name": "https",
      "host": "0.0.0.0",
      "port": 443,
      "use_http2": true,
      "protocol": "https",
      "enabled": true,
      "tls": {
        "cert_file": "/renj.io/ssl/fullchain.cer",
        "key_file": "/renj.io/ssl/ssl.key",
        "auto_tls": false
      },
      "domains": [
        {
          "domains": ["renj.io", "service.renj.io"]
        }
      ]
    }
  ],
  "middleware": [
    {
      "name": "limiter",
      "enabled": true,
      "order": 1,
      "config": {
        "limit": 100,
        "reset": 60
      }
    },
    {
      "name": "breaker",
      "enabled": true,
      "order": 2,
      "config": {
        "limit": 20,
        "reset": 10
      }
    }
  ],
  "features": {
    "http3": {
      "enabled": false,
      "max_connections": 1000,
      "idle_timeout": 60,
      "keep_alive": 60
    },
    "websocket": {
      "enabled": false,
      "ping_interval": 30,
      "pong_timeout": 10,
      "max_message_size": 1048576,
      "buffer_size": 1024
    },
    "gzip": {
      "enabled": true,
      "level": 6,
      "types": [
        "text/html",
        "text/css",
        "text/javascript",
        "application/json"
      ]
    },
    "cache": {
      "enabled": true,
      "size": 1000,
      "ttl": 60,
      "strategy": "lru"
    }
  },
  "database": {
    "mongo": {
      "url": "mongodb://localhost:27017",
      "database": "ApolloMongo",
      "timeout": 10
    },
    "influx": {
      "enabled": false,
      "url": "http://localhost:8086",
      "token": "",
      "org": "sandwich",
      "bucket": "sandwich",
      "password": ""
    }
  },
  "monitor": {
    "enabled": true,
    "port": 9090,
    "path": "/metrics",
    "interval": 10,
    "prometheus": true
  },
  "security": {
    "strict_mode": true,
    "allow_ips": [],
    "deny_ips": [],
    "rate_limit": 1000
  },
  "flow_control": {
    "enabled": true,
    "global_limit": {
      "requests": 1000,
      "window": "60s",
      "unit": "s"
    },
    "rules": [
      {
        "name": "api-limit",
        "enabled": true,
        "priority": 1,
        "match_type": "host",
        "match_value": "renj.io",
        "header_key": "",
        "limits": [
          {
            "requests": 10,
            "window": "100s",
            "unit": "s"
          },
          {
            "requests": 100,
            "window": "10min",
            "unit": "min"
          }
        ],
        "action": "block",
        "description": "API服务限流"
      }
    ],
    "recording": {
      "enabled": false,
      "record_blocked": true,
      "record_allowed": false,
      "storage_type": "file",
      "retention_period": "30d"
    }
  },
  "break": {
    "bucket": 100,
    "max_error": 10,
    "reset": 10
  },
  "front_proxy": {
    "grpc_addr": "/var/run/Helios.sock",
    "frontend_flag": "X-Proxy-Internal-Front",
    "frontend_host": "127.0.0.1",
    "frontend_port": 7777
  },
  "proxy_header": {
    "trace_id": "X-Gateway-Trace-Id",
    "frontend_host_header": "X-Proxy-Internal-Host",
    "backend_header": "X-Proxy-Internal-Local",
    "proxy_app": "X-Proxy-Backend"
  },
  "custom_header": {
    "Proxy-Copyright": "renj.io",
    "Proxy-Server": "Sandwich"
  },
  "debug": false,
  "domain_map": "domain.json",
  "job_sync_time": 15,
  "log": {
    "log_level": "info",
    "log_file": "",
    "color": true
  }
}